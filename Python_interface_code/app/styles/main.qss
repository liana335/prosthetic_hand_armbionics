MainWindow
{
    background: #013a63;
    font-family: "Segoe UI";
    font-size: 14px;
}
#panel
{
    border: 2px solid white;
    border-radius: 20px;
}



    /*USER PANEL*/
QLabel#columnTitle,
QLabel#rowTitle
{
    color: white;
    font-size: 14px;
    font-weight: bold;
}



    /*DATA PANEL*/
QFrame#separator 
{
    background: rgba(255, 255, 255, 35);
    border: none;
    max-height: 1px;
}



    /*ADD USER WINDOW*/
#addUserWindow
{
    background: #013a63;
}
QLineEdit
{
    background: transparent;
    padding: 0px 10px;
}
QLineEdit:focus
{
    background: #012a4a;
    color: white;
}
QPushButton#userButton
{
    background: #2c7da0;
    color: #000814;
    font-size: 14px;
    font-weight: bold;
    border: 2px solid #2c7da0;
    border-radius: 20px;
    padding: 0px 20px;
}
QPushButton#userButton:hover
{
    background: transparent;
    color: white;
    border-color: white;
}



    /*MESSAGE WINDOW*/
QMessageBox
{
    background: #013a63;
    color: white;
    font-size: 14px;
    font-weight: bold;
}



    /*TERMINAL*/
QPlainTextEdit#emgTerminal
{
    background: white;
    color: #000814;
    font-size: 14px;
    padding: 10px;
    border-radius: 5px;
}
QPlainTextEdit QScrollBar:vertical
{
    background: transparent;
    width: 6px;
}
QScrollBar::handle:vertical 
{
    background: #01497c;
    min-height: 25px;
    border-radius: 3px;
}
QScrollBar::handle:vertical:hover {
    background: #013a63;
}
QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
}
QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: transparent;
}


    /*REALTIME PLOT*/
QLabel#plotTitle
{
    color: white;
    font-size: 20px;
    font-weight: bold;
}



    /*HISTORY PLOT*/
QLabel#eventsCountLabel
{
    color: white;
    font-size: 14px;
    font-weight: bold;
}



    /*BUTTONS*/
QPushButton#button
{
    background: #61a5c2;
    color: #001233;
    font-size: 14px;
    font-weight: bold;
    border: 2px solid #61a5c2;
    border-radius: 20px;
    padding: 0px 15px;
}
QPushButton#button:hover
{
    background: transparent;
    color: white;
    border-color: white;
}